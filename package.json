{
  "name": "plano",
  "version": "0.3.0",
  "private": true,
  "description": "PLANO \u2014 the infinite canvas workspace for builders. One spatial screen per project: terminals, editors, browsers and AI agents, together.",
  "author": "PLANO",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w node-pty",
    "icons": "node scripts/make-icons.mjs",
    "model": "node scripts/fetch-model.mjs",
    "build:web": "npm --prefix web run build",
    "dist": "npm run model && npm run icons && npm run build:web && electron-vite build && electron-builder --publish never",
    "dist:win": "npm run model && npm run icons && npm run build:web && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run model && npm run icons && npm run build:web && electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "npm run model && npm run icons && npm run build:web && electron-vite build && electron-builder --linux --publish never",
    "release": "node scripts/publish-release.mjs",
    "release:win": "npm run dist:win && node scripts/publish-release.mjs",
    "release:linux": "npm run dist:linux && node scripts/publish-release.mjs --platform linux"
  },
  "build": {
    "appId": "app.plano.desktop",
    "productName": "PLANO",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "afterPack": "build/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "zqkra",
      "repo": "plano"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sherpa-onnx-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "web-dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PLANO",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": null,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PLANO uses the microphone for its local voice assistant. Speech is transcribed on-device and never leaves your machine."
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons",
      "category": "Development",
      "synopsis": "The infinite canvas workspace for builders",
      "description": "PLANO is an infinite canvas workspace for builders. One spatial screen per project: terminals, editors, browsers and AI agents, together.",
      "maintainer": "PLANO",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "StartupWMClass": "plano",
        "Categories": ["Development"],
        "Terminal": false
      }
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.0.7",
    "node-pty": "^1.0.0",
    "ps-list": "^8.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "sherpa-onnx-node": "^1.13.3",
    "ws": "^8.21.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
